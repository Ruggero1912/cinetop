# ==============================================================================
# CINETOP Configuration
# Copy this file to 'config.env' and fill in your personal details.
# ==============================================================================

# Your CINECA UNIX username (from userdb.hpc.cineca.it)
CINECA_USER="your_username_0"

# Your active SLURM Project / Grant Account ID (check via 'saldo -b')
CINECA_ACCOUNT="IscrC_YOURPROJECT"

# Your institutional email used for Keycloak / step-cli 2FA login
KEYCLOAK_EMAIL="name.surname@university.it"

# Cluster settings (defaults to CINECA Leonardo)
CINECA_SSH_HOST="cineca"
CINECA_HOSTNAME="login.leonardo.cineca.it"
CINECA_PARTITION="boost_usr_prod"
CINECA_WORK_BASE="/leonardo_work"
